{
  "name": "arc-gasless-react",
  "version": "0.1.0",
  "description": "A React SDK for zero-gas onboarding on the ARC Network using Circle Programmable Wallets.",
  "type": "module",
  "main": "./dist/arc-gasless-react.umd.js",
  "module": "./dist/arc-gasless-react.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/arc-gasless-react.es.js",
      "require": "./dist/arc-gasless-react.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "playground": "cd playground && npm run dev"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@circle-fin/w3s-pw-web-sdk": "^1.0.6",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-plugin-dts": "^4.0.3"
  }
}
